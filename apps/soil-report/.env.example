# Postgres connection string. Required — the app has no local-file fallback.
# For local dev against a Postgres you're running yourself:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soil_report
# For Railway (or similar hosted Postgres), use the connection string it gives you.
DATABASE_URL=

# Signs session cookies — set a long random value in any real deployment.
SESSION_SECRET=change-me-to-a-long-random-string

# Leave unset for the POC — payment is simulated. Setting this is only a
# marker checked by the pay route; real Stripe Checkout/webhook wiring is
# not implemented yet (see app/api/reports/[id]/pay/route.js).
# STRIPE_SECRET_KEY=
